module fir_filter #(
  parameter int NUM_TAPS = 64,
  parameter int DATA_WIDTH = 16,
  parameter int COEFF_WIDTH = 16
)(
  input logic clk,
  input logic rst,
  input logic signed [DATA_WIDTH-1:0] x_in,
  output logic signed [DATA_WIDTH + COEFF_WIDTH + 5:0] y_out
);
  
  //Coeff mem
  typedef logic signed [COEFF_WIDTH-1:0] coeff_t;
  coeff_t coeff [0:NUM_TAPS-1];
  
  initial begin
    $readmemh("fir_coeffs.hex", coeff);
  end
  
  //Register line
  typedef logic signed [DATA_WIDTH-1:0] sample_t;
  typedef logic signed [DATA_WIDTH+COEFF_WIDTH-1:0] product_t;
  
  sample_t delay_line [0:NUM_TAPS-1];
    
  always_ff @(posedge clk) begin
    if (rst) begin
      for (int i = 0; i < NUM_TAPS; i++) begin
        delay_line[i] <= 1'b0;
      end
    end else begin
      delay_line[0] <= x_in;
      for (int i = 1; i < NUM_TAPS; i++) begin
        delay_line[i] <= delay_line[i - 1];
      end
    end
  end
     
   // Multiplier
    product_t products [0:NUM_TAPS-1];
    always_comb begin
      for (int i = 0; i < NUM_TAPS; i++) begin
        products[i] = delay_line[i] * coeff[i];
      end
    end
    
    // Adder Tree
    
    //stage 1
  logic signed [DATA_WIDTH+COEFF_WIDTH+2:0] sum_stage1 [0:31];
    always_comb begin
      for (int i = 0; i < 32; i++) begin
        sum_stage1[i] = products[2*i] + products[2*i + 1];
      end
    end

    //stage 2
  logic signed [DATA_WIDTH+COEFF_WIDTH+3:0] sum_stage2 [0:15];
    always_comb begin
      for (int i = 0; i < 16; i++) begin
        sum_stage2[i] = sum_stage1[2*i] + sum_stage1[2*i + 1];
      end
    end

    //stage 3
  logic signed [DATA_WIDTH+COEFF_WIDTH+4:0] sum_stage3 [0:7];
    always_comb begin
      for (int i = 0; i < 8; i++) begin
        sum_stage3[i] = sum_stage2[2*i] + sum_stage2[2*i + 1];
      end
    end
    
    //stage 4
  logic signed [DATA_WIDTH+COEFF_WIDTH+5:0] sum_stage4 [0:3];
    always_comb begin
      for (int i = 0; i < 4; i++) begin
        sum_stage4[i] = sum_stage3[2*i] + sum_stage3[2*i + 1];
      end
    end
    
    //stage 5
  logic signed [DATA_WIDTH+COEFF_WIDTH+6:0] sum_stage5 [0:1];
    always_comb begin
      for (int i = 0; i < 2; i++) begin
        sum_stage5[i] = sum_stage4[2*i] + sum_stage4[2*i + 1];
      end
    end
    
    //stage 6: Final sum
  assign y_out = sum_stage5[0] + sum_stage5[1];
  
endmodule
