% 1. Setup Time and Sampling
fs = 2000;
t = 0 : 1/fs : 1;

% 2. Create the clean base signal
freq1 = 5;
signal = sin(2*pi * freq1 * t);

% 2. Generate random Gaussian noise
freq_noise = 250;
noise_amp = 0.4;
sine_noise = noise_amp * sin(2*pi*freq_noise*t);

% 3. Add noise to the clean signal
noisy_signal = signal + sine_noise;
noisy_signal = noisy_signal(:);

% Fix 1: Instantiate filter
myFilter = lowpassfir1filt(); 

% 4. Quantize the noisy signal and Drive it through the lowpass FIR
input_type = numerictype(1, 16, 15);
noisy_signal_fi = fi(noisy_signal, input_type);
filter_sig_fi = myFilter(noisy_signal_fi);
filter_sig = double(filter_sig_fi);

% 5. Plot the original, noisy signal, and filtered signal
figure(1)
plot(t,signal)

figure(2)
plot(t,noisy_signal)

figure(3)
plot(t,filter_sig)

% 6. Display the filter's taps
[b, a] = tf(lowpassfir1filt);
disp("The taps are "), disp(b);

% 7. Export taps for implementation in systemverilog
fixed_taps = fi(b, 1, 16, 15);
raw_int = fixed_taps.';

fprintf('// Verilog 16-bit (Q1.15) Fixed-Point Coefficients\n');
hex_vals = dec2hex(typecast(int16(raw_int), 'uint16'), 4);
writematrix(hex_vals, 'taps.hex', 'FileType', 'text');

% 8. Export signal for implementation in systemverilog

signal_fi = fi(noisy_signal, 1, 16, 15);
raw_signal_int = signal_fi.int;
hex_signal = dec2hex(typecast(int16(raw_signal_int), 'uint16'), 4);
writematrix(hex_signal, 'signal.hex', 'FileType', 'text');
